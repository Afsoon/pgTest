crate := "pgtest-server"

# List available recipes
help:
    @just --list --unsorted --list-prefix '  ' --list-heading $'pgTest Server\n'

# Format this crate
fmt:
    cargo +nightly fmt -p {{crate}}

# Check this crate's formatting without changing files
fmt-check:
    cargo +nightly fmt -p {{crate}} --check

# Run Clippy on all targets in this crate
lint:
    cargo clippy -p {{crate}} --all-targets -- -D warnings

# Run cargo check on this crate
check:
    cargo check -p {{crate}} --all-targets

# Check all targets with profiling enabled
check-profile:
    cargo check -p {{crate}} --all-targets --features hotpath

# Run cargo build on this crate
build:
    cargo build -p {{crate}} --all-targets

# Run cargo test on this crate
test:
    cargo test -p {{crate}}

# Build and open the docs of this crate
doc:
    cargo doc -p {{crate}} --no-deps --open

# Run this crate's binary, passing any extra arguments through
run *ARGS:
    cargo run -p {{crate}} -- {{ARGS}}

# Run the server with hotpath profiling enabled
run-profile *ARGS:
    cargo run -p {{crate}} --features hotpath -- {{ARGS}}

# Run metered; pool limits CREATE connections, PGTEST_CLEANUP_POOL_CONNECTION limits cleanup
run-metered host="127.0.0.1" user="metered" template="metered" port="5432" pool="5" initial="16":
    RUST_MIN_STACK=16777216 PGTEST_POOL_INITIAL_SIZE={{quote(initial)}} PGTEST_CREATION_POOL_CONNECTION={{quote(pool)}} PGTEST_PG_HOST={{quote(host)}} PGTEST_PG_USER={{quote(user)}} PGTEST_PG_DATABASE={{quote(template)}} PGTEST_PG_PORT={{quote(port)}} cargo run -p {{crate}}

# Run metered with a Unix socket; pool limits CREATE, PGTEST_CLEANUP_POOL_CONNECTION limits cleanup
run-metered-unix host="127.0.0.1" user="metered" template="metered" port="5432" pool="5" initial="16" socket_dir="/tmp/pgtest":
    mkdir -p -m 700 -- {{quote(socket_dir)}}
    HOTPATH_LIMIT=0 HOTPATH_OUTPUT_FORMAT=json RUST_LOG=info RUST_MIN_STACK=16777216 PGTEST_UNIX_SOCKET_DIR={{quote(socket_dir)}} PGTEST_POOL_INITIAL_SIZE={{quote(initial)}} PGTEST_CREATION_POOL_CONNECTION={{quote(pool)}} PGTEST_PG_HOST={{quote(host)}} PGTEST_PG_USER={{quote(user)}} PGTEST_PG_DATABASE={{quote(template)}} PGTEST_PG_PORT={{quote(port)}} cargo run -p {{crate}} --features hotpath
