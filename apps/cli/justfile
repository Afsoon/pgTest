crate := "cli"

# List available recipes
help:
    @just --list --unsorted --list-prefix '  ' --list-heading $'pgTest CLI\n'

# Format this crate
fmt:
    cargo +nightly fmt -p {{crate}}

# Check this crate's formatting without changing files
fmt-check:
    cargo +nightly fmt -p {{crate}} --check

# Run Clippy on all targets in this crate
lint:
    cargo clippy -p {{crate}} --all-targets -- -D warnings

# Run cargo check on this crate
check:
    cargo check -p {{crate}} --all-targets

# Check all targets with profiling enabled
check-profile:
    cargo check -p {{crate}} --all-targets --features hotpath

# Build all targets in this crate
build version commit_sha:
    @test -n {{quote(version)}} && test -n {{quote(commit_sha)}} || { echo 'version and commit_sha must not be empty' >&2; exit 1; }
    PGTEST_VERSION={{quote(version)}} PGTEST_COMMIT_SHA={{quote(commit_sha)}} cargo build -p {{crate}} --all-targets

# Build the release CLI binary
build-release version commit_sha:
    @test -n {{quote(version)}} && test -n {{quote(commit_sha)}} || { echo 'version and commit_sha must not be empty' >&2; exit 1; }
    PGTEST_VERSION={{quote(version)}} PGTEST_COMMIT_SHA={{quote(commit_sha)}} cargo build --locked --release -p {{crate}} --bin pgtest

# Run all tests in this crate (requires Docker)
test:
    cargo nextest run --locked -p {{crate}} --no-fail-fast

# Build and open the docs of this crate
doc:
    cargo doc -p {{crate}} --no-deps --open

# Run the CLI, passing any extra arguments through
[positional-arguments]
run *ARGS:
    cargo run -p {{crate}} --bin pgtest -- "$@"

# Run the CLI with hotpath profiling enabled
[positional-arguments]
run-profile *ARGS:
    cargo run -p {{crate}} --bin pgtest --features hotpath -- "$@"
